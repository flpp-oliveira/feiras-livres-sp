# ---- Arquivos pesados e regeneráveis / descartáveis ----
# Ficam de fora do repositório para não inchá-lo. Todos são baixáveis
# de novo ou gerados pelos scripts em data/.

# 7 MB — limites de distritos (baixável)
data/distritos.geojson
# 1,5 MB — export cru do My Maps (mantemos o .kmz e o coords.csv)
data/mymaps.kml
# viewers antigos, superados por site/
data/viewer.html
data/viewer_novo.html
# bundle antigo do app
data/appmapa.js
# logs de geocodificação
data/*.log

# ---- Ruído de sistema ----
Thumbs.db
Desktop.ini
.DS_Store

# ---- Desenvolvimento local (wrangler pages dev) ----
# segredo local do canal de reports e o banco D1 de teste desta maquina
.dev.vars
.wrangler/

# ---- Testes ----
# dependencias do Playwright (npm install em testes/) e as fotos de cada rodada
testes/node_modules/
testes/capturas/
